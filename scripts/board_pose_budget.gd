extends RefCounted
# V54 heuristic pose budget. This is NOT semantic image understanding.
# The user's drawing-count control remains a hard GPU budget.
func estimate(story: String, duration: float, budget: int) -> Dictionary:
    var normalized: String = story.to_lower().strip_edges()
    if normalized.is_empty() or duration <= 0.0 or budget < 1:
        return {"ok": false, "error": "Description, duree ou budget invalide."}
    var motion: Dictionary = load("res://scripts/story_motion_planner.gd").new().plan(story, duration)
    var steps: Array = motion.get("steps", [])
    if not motion.get("ok", false):
        return {"ok": false, "error": "Scenario sans action exploitable."}
    # Count planned beats once, not overlapping substrings (run/runs).
    # These are key drawings; video frames are generated by interpolation.
    var phases: Dictionary = load("res://scripts/board_generation_plan.gd").ACTION_PHASES
    var actions: int = steps.size()
    var interactions: int = 0
    var recommended: int = 0
    for step in steps:
        var action: String = str(step["action"])
        var complexity: int = phases.get(action, phases["inconnu"]).size()
        var step_duration: float = float(step["end"]) - float(step["start"])
        if action == "interaction":
            interactions += 1
        recommended += maxi(complexity, ceili(step_duration * (0.5 if action == "repos" else 1.5)))
    recommended = clampi(recommended, 2, 240)
    var selected: int = mini(recommended, mini(budget, 240))
    return {"ok": true, "recommended": recommended, "selected": selected, "budget": budget, "actions_detected": actions, "interactions_detected": interactions, "limited_by_budget": selected < recommended, "method": "keyword_heuristic_not_semantic"}
