extends SceneTree

func _initialize() -> void:
    call_deferred("run")

func run() -> void:
    var session: RefCounted = load("res://scripts/karma_studio_session.gd").new()
    var folder: String = "user://karma_step10_%d" % Time.get_ticks_usec()
    assert(DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(folder)) == OK)
    var start: Dictionary = session.begin("Une banane avance puis tombe", 4.0, 2)
    assert(start.get("ok", false), "Agent planner must accept valid stories")
    session.record_frame(0, folder.path_join("frame0.png"), {"ok": true})
    session.record_frame(1, folder.path_join("frame1.png"), {"ok": true})
    session.finish_drawings("")
    assert(session.state["agents"]["video"] == "waiting_for_user")
    assert(not session.state["frames"]["0"]["human_approved"])
    assert(session.save(folder))
    var ledger_path: String = folder.path_join("karma_agents.json")
    var saved: Variant = JSON.parse_string(FileAccess.get_file_as_string(ledger_path))
    assert(saved is Dictionary and saved["agents"]["video"] == "waiting_for_user")
    session.record_video_result(folder.path_join("missing.mp4"))
    assert(session.state["agents"]["video"] == "failed", "Missing MP4 must never be reported as encoded")
    var bad_path: String = folder.path_join("bad.mp4")
    var bad: FileAccess = FileAccess.open(bad_path, FileAccess.WRITE)
    bad.store_buffer(PackedByteArray([0, 0, 0, 8]))
    bad.close()
    session.record_video_result(bad_path)
    assert(session.state["agents"]["video"] == "failed", "Invalid MP4 must never be reported as encoded")
    session.record_user_approval("fingerprint-1")
    assert(session.state["agents"]["video"] == "encoding_after_user_approval")
    assert(session.state["frames"]["0"]["human_approved"])
    assert(session.state["frames"]["1"]["human_approved"])
    var after: Variant = JSON.parse_string(FileAccess.get_file_as_string(ledger_path))
    assert(after is Dictionary and after["human_review"]["fingerprint"] == "fingerprint-1")
    assert(after["agents"]["video"] == "encoding_after_user_approval")
    var coordinator: RefCounted = load("res://scripts/karma_one_agents.gd").new()
    assert(coordinator.diagnose("quota exceeded", 429)["retryable"])
    assert(coordinator.diagnose("", 503)["action"] == "essayer_moteur_secondaire")
    assert(not coordinator.diagnose("", 401)["retryable"])
    print("KARMA_STEP10_AGENT_LEDGER_AND_EXPORT_GATES_OK")
    quit(0)
