extends SceneTree
func _initialize() -> void:
    call_deferred("run")
func run() -> void:
    var save_path: String = "user://mobilei2v_storyboard_v23.json"
    var existed: bool = FileAccess.file_exists(save_path)
    var backup: PackedByteArray = FileAccess.get_file_as_bytes(save_path) if existed else PackedByteArray()
    var folder: String = "user://review_pipeline_test_%d" % Time.get_ticks_usec()
    assert(DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(folder)) == OK)
    var reference := Image.create(512, 512, false, Image.FORMAT_RGB8)
    reference.fill(Color.YELLOW)
    reference.fill_rect(Rect2i(100, 100, 300, 300), Color.RED)
    var input_path: String = folder.path_join("gallery.png")
    assert(reference.save_png(input_path) == OK)
    var board: Control = load("res://scripts/storyboard.gd").new()
    root.add_child(board)
    await board._image_chosen(input_path)
    assert(board.preview.texture != null)
    assert(board.preview.texture.get_image().get_pixel(150, 150).is_equal_approx(Color.RED))
    assert(FileAccess.file_exists(board.imported_path))
    assert(board.sources.size() == 1 and board.paths[0] == board.imported_path)
    board._load_saved()
    assert(board.preview.texture != null and board.sources.size() == 1, "Imported photo must survive reopening")
    var first_path: String = folder.path_join("frame_0000.png")
    var second_path: String = folder.path_join("frame_0001.png")
    assert(reference.save_png(first_path) == OK)
    var second: Image = reference.duplicate()
    second.fill_rect(Rect2i(50, 50, 100, 100), Color.BLUE)
    assert(second.save_png(second_path) == OK)
    board.sources.assign([ImageTexture.create_from_image(reference), ImageTexture.create_from_image(second)])
    board.paths.assign([first_path, second_path])
    board.accepted.assign([true, true])
    board.plan.assign([0, 1])
    board._sync_friendly_ui()
    await board._export_board_mp4()
    assert(board.status.text.contains("ton accord"), "Even imported/auto-accepted frames need explicit human confirmation")
    board.review_check.set_pressed(true)
    assert(board._has_current_review())
    board.review_index = 0
    board._review_choose(false)
    board.review_check.set_pressed(true)
    assert(not board._has_current_review() and not board.review_check.button_pressed)
    board._review_choose(true)
    board.review_check.set_pressed(true)
    assert(board._has_current_review())
    second.fill_rect(Rect2i(0, 0, 20, 20), Color.GREEN)
    assert(second.save_png(second_path) == OK)
    assert(not board._has_current_review(), "A drawing changed after review must invalidate approval")
    var client: Node = load("res://scripts/hf_studio_generator.gd").new()
    var prompt: String = client.build_reference_prompt("une banane", "cartoon")
    assert(prompt.contains("une banane"))
    assert(not prompt.contains("Single full body character") and not prompt.contains("neutral standing pose"))
    assert(prompt.contains("unless requested"))
    client.free()
    var session: RefCounted = load("res://scripts/karma_studio_session.gd").new()
    assert(session.begin("Il marche puis court", 6.0, 2)["ok"])
    assert(session.inspect_frame(reference)["ok"])
    var small := Image.create(32, 32, false, Image.FORMAT_RGB8)
    assert(not session.inspect_frame(small)["ok"])
    session.record_frame(0, first_path, session.inspect_frame(reference))
    session.finish_drawings("")
    assert(session.save(folder))
    var ledger: Variant = JSON.parse_string(FileAccess.get_file_as_string(folder.path_join("karma_agents.json")))
    assert(ledger["agents"]["video"] == "waiting_for_user")
    assert(not ledger["frames"]["0"]["human_approved"])
    board.free()
    if existed:
        var file := FileAccess.open(save_path, FileAccess.WRITE)
        file.store_buffer(backup)
        file.close()
    else:
        DirAccess.remove_absolute(save_path)
    print("REFERENCE_IMPORT_SUBJECT_PROMPT_AND_REVIEW_GATE_OK")
    quit(0)
