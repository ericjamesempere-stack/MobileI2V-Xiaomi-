extends SceneTree

func _initialize() -> void:
    var rig: Control = load("res://scripts/rig_character.gd").new()
    assert(rig.has_method("update_pose"))
    assert(rig.has_method("update_expression"))
    rig.update_pose(0.2, "marche")
    rig.update_expression(0.2, "happy")
    assert(rig.facial_expression == "happy")
    rig.update_expression(0.3, "surprised")
    assert(rig.facial_expression == "surprised")
    rig.update_expression(0.4, "neutral")
    assert(rig.facial_expression == "neutral")
    rig.update_pose(0.0, "chute")
    var fall_start: Dictionary = rig._compute_pose(0.0)
    var fall_end: Dictionary = rig._compute_pose(1.0)
    assert((fall_start["chest"] as Vector2).distance_to(fall_end["chest"] as Vector2) > 80.0)
    assert((fall_start["ankle_l"] as Vector2).distance_to(fall_end["ankle_l"] as Vector2) > 80.0)
    rig.update_pose(0.0, "saut")
    var jump_start: Dictionary = rig._compute_pose(0.0)
    var jump_middle: Dictionary = rig._compute_pose(0.5)
    assert((jump_start["hip"] as Vector2).y - (jump_middle["hip"] as Vector2).y > 100.0)
    rig.free()
    print("FRAME_GENERATOR_RIG_INTERFACE_TESTS_OK")
    quit(0)
