extends SceneTree
func _initialize() -> void:
    call_deferred("run")
func run() -> void:
    var agents: RefCounted = load("res://scripts/karma_optimization_agents.gd").new()
    var registry: RefCounted = load("res://scripts/karma_module_registry.gd").new()
    var balanced: Dictionary = agents.device_budget(4096, 0, 80, false)
    var economy: Dictionary = agents.device_budget(1200, 3, 15, false)
    var paused: Dictionary = agents.device_budget(512, 5, 5, false)
    assert(balanced["ok"] and balanced["parallel_inference"] == 1)
    assert(economy["ok"] and economy["max_edge"] == 512)
    assert(not paused["ok"] and paused["parallel_inference"] == 0)
    var vision: Dictionary = agents.vision_plan(4000, 2000, balanced)
    assert(vision["ok"] and vision["width"] == 768 and vision["height"] == 384)
    assert(agents.vision_plan(4000, 2000, balanced)["preserve_original"])
    assert(not agents.vision_plan(4000, 2000, paused)["ok"])
    var image_plan: Dictionary = agents.image_plan(economy)
    assert(image_plan["batch"] == 1 and image_plan["target_edge"] == 512 and not image_plan["cloud_fallback"])
    var motion: Dictionary = agents.motion_plan(5.0, 30, balanced)
    assert(motion["total_frames"] == 150 and motion["keyframes"] < motion["total_frames"])
    assert(not agents.quality_gate({})["ok"])
    assert(agents.quality_gate({"reference_similarity": 0.9, "temporal_consistency": 0.9, "artifact_score": 0.1})["ok"])
    assert(not agents.quality_gate({"reference_similarity": 0.2, "temporal_consistency": 0.9, "artifact_score": 0.1})["ok"])
    assert(not agents.supervisor_plan("image", registry)["ok"])
    print("KARMA_OPTIMIZATION_AGENTS_OK")
    quit(0)
