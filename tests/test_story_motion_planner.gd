extends SceneTree
# Run with: godot --headless --path . --script res://tests/test_story_motion_planner.gd
func _initialize() -> void:
    var planner: RefCounted = load("res://scripts/story_motion_planner.gd").new()
    var data: Dictionary = planner.plan("Il court puis trébuche puis tombe. Ensuite il se relève.", 8.0)
    assert(bool(data.get("ok", false)), "Story should be recognized")
    var steps: Array = data.get("steps", [])
    assert(steps.size() == 4, "Expected four movements")
    assert(steps[0]["action"] == "course")
    assert(steps[1]["action"] == "trebuche")
    assert(steps[2]["action"] == "chute")
    assert(steps[3]["action"] == "releve")
    assert(absf(float(steps[-1]["end"]) - 8.0) < 0.001)
    var empty: Dictionary = planner.plan("...", 5.0)
    assert(not bool(empty.get("ok", true)))
    var arbitrary: Dictionary = planner.plan("Il court puis fait une pirouette sur une main puis vole.", 6.0)
    assert(arbitrary["steps"].size() == 3, "Unknown actions must not disappear")
    assert(arbitrary["steps"][0]["action"] == "course")
    assert(arbitrary["steps"][1]["action"] == "inconnu")
    assert(arbitrary["steps"][1]["needs_generation"])
    assert(arbitrary["steps"][2]["action"] == "inconnu")
    var chained: Dictionary = planner.plan("Il court et tombe et se relève", 6.0)
    var chain_steps: Array = chained.get("steps", [])
    assert(chain_steps.size() == 3, "Conjoined movements must be split into three actions")
    assert(chain_steps[0]["action"] == "course")
    assert(chain_steps[1]["action"] == "chute")
    assert(chain_steps[2]["action"] == "releve")
    var english: Dictionary = planner.plan("He runs and falls and gets up", 6.0)
    var en_steps: Array = english.get("steps", [])
    assert(en_steps.size() == 3, "English conjunctions must split gestures")
    assert(en_steps[0]["action"] == "course")
    assert(en_steps[1]["action"] == "chute")
    assert(en_steps[2]["action"] == "releve")
    print("STORY_MOTION_PLANNER_TESTS_OK")
    quit(0)
